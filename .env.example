# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=        # required: powers the agent
OPENAI_API_KEY=           # required for the default speech-to-text (Whisper API); not needed with stt.backend: faster_whisper
TYPESAFE_API_KEY=         # optional: TypeSafe Jev routing / complexity / risk (falls back to a small model without it)
TAVILY_API_KEY=           # optional: news / search skill
OPENWEATHERMAP_API_KEY=   # optional: weather skill
